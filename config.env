# Kernel source (our fork with KPROBES+KSU enabled)
KERNEL_SOURCE=https://github.com/3032252626/android_kernel_xiaomi_sm8150

# Kernel branch
KERNEL_SOURCE_BRANCH=a14-xiaomi-4.14.y

# Kernel defconfig
KERNEL_CONFIG=raphael_stock_defconfig

# Output zip name
KERNEL_ZIP_NAME=raphael-ksu-lxc

# Kernel image name (dtb embedded in kernel)
KERNEL_IMAGE_NAME=Image.gz-dtb

# KVM
ENABLE_KVM=false

# LXC/Docker
ENABLE_LXC_DOCKER=true

# LLVM
LLVM_CONFIG=n

# KernelSU (lock v0.9.5 for non-GKI)
ENABLE_KERNELSU=true
KERNELSU_TAG=v0.9.5
ENABLE_PATH_UMOUNT=true

# Other
SWITCH_PYTHON=false
NEED_DTBO=false