# Kernel source
KERNEL_SOURCE=https://github.com/SOVIET-ANDROID/kernel_xiaomi_raphael

# Kernel branch
KERNEL_SOURCE_BRANCH=16.0

# Kernel defconfig
KERNEL_CONFIG=raphael_defconfig

# Output zip name
KERNEL_ZIP_NAME=raphael_Zundamon-v4.1-LXC-KernelSU-tiann

# KVM
ENABLE_KVM=false

# LXC/Docker
ENABLE_LXC_DOCKER=true

# LLVM=1 LLVM_IAS=1
LLVM_CONFIG=n

# KernelSU (actual inject is fixed by workflow: tiann setup.sh v0.9.5)
ENABLE_KERNELSU=true
KERNELSU_TAG=main
ENABLE_PATH_UMOUNT=true
