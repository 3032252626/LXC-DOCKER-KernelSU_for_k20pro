# Kernel source  (stock tree = same source as the working authorship kernel)
KERNEL_SOURCE=https://github.com/qaz6750/android_kernel_xiaomi_sm8150

# Kernel branch
KERNEL_SOURCE_BRANCH=a14-xiaomi-4.14.y

# Kernel defconfig  (164726B full config = proven bootable)
KERNEL_CONFIG=raphael_stock_defconfig

# Output zip name
KERNEL_ZIP_NAME=raphael_Zundamon-v5.0-stock-LXC-KernelSU-tiann

# KVM
ENABLE_KVM=false

# LXC/Docker
ENABLE_LXC_DOCKER=true

# LLVM=1 LLVM_IAS=1
LLVM_CONFIG=n

# KernelSU (actual inject is fixed by workflow: tiann setup.sh v0.9.5)
ENABLE_KERNELSU=true
KERNELSU_TAG=main
ENABLE_PATH_UMOUNT=true
